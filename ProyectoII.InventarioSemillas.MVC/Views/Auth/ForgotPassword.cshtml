@using ProyectoII.InventarioSemillas.MVC.Models.Auth
@model LoginViewModel
@{
    ViewData["Title"] = "¿Olvido su contraseña?";
}

<h1>@ViewData["Title"]</h1>
<h2>Ingrese su correo electrónico</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="correo@ejemplo.com" />
                <label asp-for="Email" class="form-label">Correo electrónico</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Resetear contraseña</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
