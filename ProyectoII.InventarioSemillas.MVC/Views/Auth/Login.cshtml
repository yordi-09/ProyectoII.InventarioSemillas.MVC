@using ProyectoII.InventarioSemillas.MVC.Models.Auth
@model LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <section>
            <form id="account" asp-action="Login" asp-controller="Auth" method="post">
                <h2>Ingrese sus credenciales</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="correo@ejemplo.com" />
                    <label asp-for="Email" class="form-label">Correo electrónico</label>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" aria-required="true"/>
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Iniciar sesión</button>
                </div>

                <div class="mt-3">
                    <p>
                        <a asp-controller="Auth" asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
