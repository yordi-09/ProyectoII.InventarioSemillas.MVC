@model ProyectoII.InventarioSemillas.MVC.Models.Especies.EspecieDto

@{
    ViewData["Title"] = "Registrar especie";
    var familias = ViewBag.FamiliasDropdown as List<dynamic>;
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="NombreCientifico" class="form-label"></label>
                <input asp-for="NombreCientifico" class="form-control" />
                <span asp-validation-for="NombreCientifico" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NombreComun" class="form-label"></label>
                <input asp-for="NombreComun" class="form-control" />
                <span asp-validation-for="NombreComun" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label for="familiaSelect" class="form-label">Familia a la que pertenece: <span class="text-danger">*</span></label>
                <select id="familiaSelect" name="familia" class="form-control" required data-val="true" data-val-required="La Familia es requerida">
                    <option value="">Seleccione una</option>
                    @foreach (var f in familias!)
                    {
                        <option value="@f.Familia">@f.Familia</option>
                    }
                </select>
                <span class="text-danger field-validation-valid" data-valmsg-for="familia" data-valmsg-replace="true"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
