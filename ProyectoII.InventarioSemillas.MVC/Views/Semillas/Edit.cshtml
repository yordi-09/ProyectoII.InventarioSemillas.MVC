@model ProyectoII.InventarioSemillas.MVC.Models.Semillas.SemillaDto

@{
    ViewData["Title"] = "Editar semilla";
    var especies = ViewBag.Especies as List<ProyectoII.InventarioSemillas.MVC.Models.Especies.EspecieDto>;
    var ubicaciones = ViewBag.Ubicaciones as List<ProyectoII.InventarioSemillas.MVC.Models.Ubicaciones.UbicacionDto>;
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EspecieId" class="form-label"></label>
                <select asp-for="EspecieId" class="form-control" asp-items="@(new SelectList(especies, "Id", "NombreCientifico"))">
                    <option value="">Seleccione una especie</option>
                </select>
                <span asp-validation-for="EspecieId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="UbicacionId" class="form-label"></label>
                <select asp-for="UbicacionId" class="form-control" asp-items="@(new SelectList(ubicaciones, "Id", "Nombre"))">
                    <option value="">Seleccione una ubicación</option>
                </select>
                <span asp-validation-for="UbicacionId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Cantidad" class="form-label"></label>
                <input asp-for="Cantidad" class="form-control" type="number" min="0" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaAlmacenamiento" class="form-label"></label>
                <input asp-for="FechaAlmacenamiento" class="form-control" type="date" />
                <span asp-validation-for="FechaAlmacenamiento" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}