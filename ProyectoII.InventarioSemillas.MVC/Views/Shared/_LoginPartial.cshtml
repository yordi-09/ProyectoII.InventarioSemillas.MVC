<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <li class="nav-item">
            <a class="nav-link custom-login" asp-controller="Auth" asp-action="Index">
                Bienvenido @User.Identity.Name!
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link custom-login" asp-controller="Auth" asp-action="Logout">Cerrar sesión</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link custom-login" asp-controller="Auth" asp-action="Login">Iniciar sesión</a>
        </li>
    }
</ul>
